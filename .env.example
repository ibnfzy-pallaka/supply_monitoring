# ================================================================
# Supabase Environment — TEMPLATE (jangan isi nilai asli di sini)
# Copy file ini ke .env (development) dan .env.production (produksi)
#
# Sumber nilai:
# - Cloud: Supabase Dashboard > Project Settings > API
#   - URL       = Project URL
#   - ANON_KEY  = anon / publishable key
#   - SERVICE_ROLE_KEY = service_role / secret key (RAHASIA, server-only)
# - Lokal (Supabase CLI): jalankan `npx supabase status`
#   untuk mendapatkan URL & keys instance lokal (http://127.0.0.1:54321)
# ================================================================

# --- Publik (aman terekspos ke browser, prefix PUBLIC_) ---
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# --- Rahasia (server-only, JANGAN pernah di-prefix PUBLIC_) ---
# Dipakai untuk operasi admin (manajemen user, bypass RLS saat perlu)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
